Options -Indexes
Options -MultiViews

# Bloqueio de acesso direto a pastas internas (uploads fica liberado para
# exibir as fotos de avarias e OTIF; a proteção dele está em uploads/.htaccess)
RewriteEngine On
RewriteRule ^(config|app|database|logs)(/|$) - [F,L,NC]

# Força requisições web para o Front Controller único
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]

# Protege arquivos sensíveis
<FilesMatch "^(config\.php|database\.php)$">
    Require all denied
</FilesMatch>